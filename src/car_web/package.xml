<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_web</name>
  <version>0.1.0</version>
  <description>小车移动、建图和单点多点导航的FastAPI网页桥接包</description>
  <maintainer email="hao@qq.com">hao</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>car_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>car_mapping</exec_depend>
  <exec_depend>car_navigation</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
